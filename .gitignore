.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local env and keys
.env*
*.pem
*.log

# Local-only source assets (Blender, renders, evidence, photos); runtime copies live in web/public
assets/

# Agent / MCP scratch output
.playwright-mcp/
.serena/
graphify-out/
